      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(wishlist_http_request_duration_seconds_bucket{namespace=\"wishlist\", app=\"wishlist-service\", route=~\"/api/v1/.*\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
