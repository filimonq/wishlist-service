{
  "id": null,
  "uid": "wishlist-service",
  "title": "Wishlist · приложение и SLA",
  "description": "RED, Go runtime, бизнес-операции и пробер. Источник — VictoriaMetrics. Выбор Pod меняет только runtime. SLA показан за демонстрационные 10 минут.",
  "tags": [
    "wishlist",
    "sre"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Pod (runtime)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoria-metrics"
        },
        "query": {
          "query": "label_values(up{namespace=\"wishlist\", app=\"wishlist-service\"}, pod)",
          "refId": "pod-variable"
        },
        "definition": "label_values(up{namespace=\"wishlist\", app=\"wishlist-service\"}, pod)",
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "PostgreSQL Exporter",
      "type": "link",
      "url": "/d/wishlist-postgres",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Обзор приложения",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Проверка пользовательского сценария",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Чтение контрольного вишлиста через Service и PostgreSQL. Только свежий результат работающего пробера. Нет данных — доступность неизвестна.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "max(last_over_time(wishlist_probe_success{namespace=\"wishlist\", app=\"wishlist-prober\"}[1m])) and (max(last_over_time(up{namespace=\"wishlist\", app=\"wishlist-prober\"}[1m])) == 1) and ((time() - max(last_over_time(wishlist_probe_last_check_timestamp_seconds{namespace=\"wishlist\", app=\"wishlist-prober\"}[1m]))) < 60)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "неуспешно",
                  "color": "red"
                },
                "1": {
                  "text": "успешно",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "API · запросов в секунду",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Сумма rate по всем репликам. Только /api/v1/, без health checks и frontend.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "sum(rate(wishlist_http_requests_total{namespace=\"wishlist\", app=\"wishlist-service\", route=~\"/api/v1/.*\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "API · доля 5xx",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Доля серверных ошибок по всем репликам. При отсутствии трафика нет значения, а не 0% ошибок.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "100 * (sum(rate(wishlist_http_requests_total{namespace=\"wishlist\", app=\"wishlist-service\", route=~\"/api/v1/.*\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(wishlist_http_requests_total{namespace=\"wishlist\", app=\"wishlist-service\", route=~\"/api/v1/.*\"}[$__rate_interval]))) and ((sum(rate(wishlist_http_requests_total{namespace=\"wishlist\", app=\"wishlist-service\", route=~\"/api/v1/.*\"}[$__rate_interval]))) > 0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "API · p95 задержки",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Квантиль общей гистограммы всех реплик. 95% завершённых запросов не медленнее этого значения; при отсутствии запросов значения нет.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
