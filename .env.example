# Logging metadata
APP_VERSION=dev
APP_ENV=development

# HTTP
# Server port for both direct and Compose startup.
HTTP_PORT=8080
# Internal metrics listener; not published by Compose.
METRICS_PORT=9090
# Published port on the host (Compose); use 0 for multiple backend instances.
HOST_PORT=8080

# Database: example credentials for local development only.
DB_CONN=postgres://wishlist:wishlist@postgres:5432/wishlist?sslmode=disable
POSTGRES_DB=wishlist
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=wishlist

# Set a random secret before starting; generate it with: openssl rand -hex 32
# Use the same secret for all backend instances of one deployment.
JWT_SECRET=

MIGRATIONS_PATH=migrations

# Demo faults for GET /api/v1/public/:token only; disabled by default.
DEMO_DELAY=0s
DEMO_ERROR_RATE=0
